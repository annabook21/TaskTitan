  let expression = 'SET #id = if_not_exists(#id, :id), #createdAt = if_not_exists(#createdAt, :now), #updatedAt = :now, #gsi1sk = if_not_exists(#gsi1sk, :gsi1sk)';
  const expNames = {
    '#id': 'id',
