  // BatchGetItem format per AWS docs: tables: { tableName: { keys: [...] } }
  const keys = memberships.map(m => util.dynamodb.toMapValues({ pk: 'TEAM#' + m.teamId, sk: 'METADATA' }));
  return {
    operation: 'BatchGetItem',
