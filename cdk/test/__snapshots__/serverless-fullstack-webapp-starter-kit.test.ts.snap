    "AppSyncGraphqlApiSchemaC2E94F39": {
      "Properties": {
        "ApiId": {
          "Fn::GetAtt": [
            "AppSyncGraphqlApi48248BEB",
            "ApiId",
          ],
        },
        "Definition": "# Phase 2/3: AppSync GraphQL API (main API; CloudFront + S3 frontend, no App Runner)
# Auth: Cognito User Pools. Data: DynamoDB (same table as ElectroDB) + Lambda (Bedrock).
# Region: us-east-2.

type User {
  id: ID!
  email: String!
  name: String
  avatarUrl: String
  createdAt: String
  updatedAt: String
}

type Project {
  id: ID!
  name: String!
  description: String
  teamId: String!
  ownerId: String!
  createdAt: String
  updatedAt: String
}

type Team {
  id: ID!
  name: String!
  description: String
  createdAt: String
  updatedAt: String
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

type Membership {
  id: ID!
  userId: String!
  teamId: String!
  role: MemberRole!
  joinedAt: String
  title: String
  hoursPerDay: Int
  availability: Int
  user: User
}

type TeamWithMembers {
  team: Team!
  members: [Membership!]!
}

type Query {
  # Get the current authenticated user (DynamoDB: pk=USER#sub, sk=METADATA)
  getCurrentUser: User
  # Get a user by email (DynamoDB GSI1: gsi1pk=EMAIL#email, gsi1sk=USER)
  getUserByEmail(email: String!): User
  # Get a single project by ID (DynamoDB: pk=PROJECT#id, sk=METADATA)
  getProject(id: ID!): Project
  # Get a single team by ID (DynamoDB: pk=TEAM#id, sk=METADATA)
  getTeam(id: ID!): Team
  # List teams for current user (DynamoDB GSI1: gsi1pk=USER#userId → batch get teams)
  listTeamsForUser: [TeamWithMembers!]!
  # Get team with all members (DynamoDB: GetItem TEAM#id + Query sk begins_with MEMBER#)
  getTeamWithMembers(teamId: ID!): TeamWithMembers
  # List projects for a team (DynamoDB GSI2: gsi2pk=TEAM#teamId)
  listProjectsByTeam(teamId: ID!): [Project!]!
}

input CreateProjectInput {
  id: ID!
  teamId: ID!
  ownerId: ID!
  name: String!
  description: String
}

input CreateTeamInput {
  id: ID!
  name: String!
  description: String
}

input UpdateTeamInput {
  name: String
  description: String
}

input AddTeamMemberInput {
  teamId: ID!
  userId: ID!
  role: MemberRole!
  title: String
}

input UpdateMemberRoleInput {
  teamId: ID!
  userId: ID!
  role: MemberRole!
}

# AI generation: Lambda (Bedrock) invoked by AppSync; returns generated text.
type Mutation {
  generateComponentViaAI(projectId: ID!, prompt: String!): String
  createProject(input: CreateProjectInput!): Project!
  # Team mutations
  createTeam(input: CreateTeamInput!): TeamWithMembers!
  updateTeam(teamId: ID!, input: UpdateTeamInput!): Team!
  addTeamMember(input: AddTeamMemberInput!): Membership!
  removeTeamMember(teamId: ID!, userId: ID!): Boolean!
  updateMemberRole(input: UpdateMemberRoleInput!): Membership!
}

schema {
  query: Query
  mutation: Mutation
}
",
      },
      "Type": "AWS::AppSync::GraphQLSchema",
    },
    "AppSyncGraphqlBatchGetTeamsFn9CA14089": {
      "DependsOn": [
        "AppSyncGraphqlApiDynamoDBA02B9D11",
        "AppSyncGraphqlApiSchemaC2E94F39",
      ],
      "Properties": {
        "ApiId": {
          "Fn::GetAtt": [
            "AppSyncGraphqlApi48248BEB",
            "ApiId",
          ],
        },
        "Code": {
          "Fn::Join": [
            "",
            [
              "import { util } from '@aws-appsync/utils';
export function request(ctx) {
  const memberships = ctx.stash.memberships || [];
  if (memberships.length === 0) return { operation: 'Query', query: { expression: 'pk = :pk', expressionValues: util.dynamodb.toMapValues({ ':pk': 'NONE' }) } };
  const keys = memberships.map(m => util.dynamodb.toMapValues({ pk: 'TEAM#' + m.teamId, sk: 'METADATA' }));
  return {
    operation: 'BatchGetItem',
    tables: {
      '",
              {
                "Ref": "DynamoTableE5532DA8",
              },
              "': { keys }
    }
  };
}
export function response(ctx) {
  if (ctx.error) util.error(ctx.error.message, ctx.error.type);
  const memberships = ctx.stash.memberships || [];
  const teams = ctx.result.data['",
              {
                "Ref": "DynamoTableE5532DA8",
              },
              "'] || [];
  const teamMap = {};
  for (const team of teams) {
    teamMap[team.id] = team;
  }
  return memberships.map(m => ({
    team: teamMap[m.teamId] || { id: m.teamId, name: 'Unknown' },
    members: [m]
  })).filter(t => t.team.id);
}",
            ],
          ],
        },
        "DataSourceName": "DynamoDB",
        "FunctionVersion": "2018-05-29",
        "Name": "batchGetTeams",
        "Runtime": {
          "Name": "APPSYNC_JS",
          "RuntimeVersion": "1.0.0",
        },
      },
      "Type": "AWS::AppSync::FunctionConfiguration",
    },
    "AppSyncGraphqlCreateProjectResolverAE2D7277": {
