    "AppSyncGraphqlAssignComponentToSprintResolver4D05BFF0": {
      "DependsOn": [
        "AppSyncGraphqlApiDynamoDBA02B9D11",
        "AppSyncGraphqlApiSchemaC2E94F39",
      ],
      "Properties": {
        "ApiId": {
          "Fn::GetAtt": [
