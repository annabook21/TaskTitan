  ctx.stash.query = ctx.args.query.toLowerCase();
  ctx.stash.teamId = ctx.args.teamId;

  // Query all team members
  return {
    operation: 'Query',
    query: {
      expression: 'pk = :pk AND begins_with(sk, :sk)',
      expressionValues: util.dynamodb.toMapValues({
        ':pk': 'TEAM#' + ctx.args.teamId,
        ':sk': 'MEMBER#'
      })
    },
    limit: 100
  };
}
