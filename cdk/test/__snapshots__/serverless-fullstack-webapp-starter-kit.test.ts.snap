      "Type": "AWS::IAM::Role",
    },
    "AppSyncGraphqlApiSchemaC2E94F39": {
      "Properties": {
        "ApiId": {
          "Fn::GetAtt": [
            "AppSyncGraphqlApi48248BEB",
            "ApiId",
          ],
        },
        "Definition": "# Phase 2/3: AppSync GraphQL API (main API; CloudFront + S3 frontend, no App Runner)
# Auth: Cognito User Pools. Data: DynamoDB (same table as ElectroDB) + Lambda (Bedrock).
# Region: us-east-2.

type User {
  id: ID!
  # Email is nullable to handle edge cases where user record exists but email wasn't migrated
  email: String
  name: String
  avatarUrl: String
  createdAt: String
  updatedAt: String
  # Timestamp-based "Read Until" marker for O(1) mark-all-as-read (AWS best practice)
  # Notifications with createdAt <= notificationsReadUntil are considered read
  notificationsReadUntil: String
}

type Project {
  id: ID!
  name: String!
  description: String
  teamId: String!
  ownerId: String!
  createdAt: String
  updatedAt: String
}

type Team {
  id: ID!
  name: String!
  description: String
  createdAt: String
  updatedAt: String
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ComponentType {
  EPIC
  FEATURE
  STORY
  TASK
  BUG
}

enum ComponentStatus {
  PLANNING
  IN_PROGRESS
  BLOCKED
  REVIEW
  COMPLETED
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

# Sprint: time-boxed iteration for a team
# pk=SPRINT#id, sk=METADATA, gsi1pk=TEAM#teamId, gsi1sk=SPRINT#id
type Sprint {
  id: ID!
  teamId: String!
  name: String!
  goal: String
  status: SprintStatus!
  startDate: String
  endDate: String
  createdAt: String
  updatedAt: String
}

type SprintWithComponents {
  sprint: Sprint!
  components: [Component!]!
}

type Component {
  id: ID!
  name: String!
  description: String
  type: ComponentType!
  projectId: String!
  parentId: String
  sprintId: String
  status: ComponentStatus!
  priority: Int
  estimatedHours: Float
  actualHours: Float
  dueDate: String
  owner: String
  tags: [String!]
  createdAt: String
  updatedAt: String
  # Kanban: Timestamp when work started (for cycle time calculation)
  # Cycle Time = completedAt - startedAt (Little's Law)
  startedAt: String
  # Shape Up: Manual hill chart position (0-100)
  # 0-50 = "figuring things out" (uphill), 51-100 = "making it happen" (downhill)
  hillPhase: Int
}

type Membership {
  id: ID!
  userId: String!
  teamId: String!
  role: MemberRole!
  joinedAt: String
  title: String
  hoursPerDay: Int
  availability: Int
  user: User
}

# Dependency represents a "depends on" relationship between components
# pk=COMPONENT#fromId, sk=DEPENDS_ON#toId, gsi1pk=REQUIRED_BY#toId, gsi1sk=COMPONENT#fromId
type Dependency {
  fromComponentId: ID!
  toComponentId: ID!
  createdAt: String
}

# Assignment represents a user assigned to a component
# pk=COMPONENT#componentId, sk=ASSIGNEE#userId, gsi1pk=USER#userId, gsi1sk=ASSIGNMENT#componentId
type Assignment {
  id: ID!
  componentId: ID!
  userId: ID!
  assignedAt: String!
  user: User
  component: Component
}

# For MyTasksPage - returns assignments with full component details
type AssignmentWithComponent {
  assignment: Assignment!
  component: Component!
}

type TeamWithMembers {
  team: Team!
  members: [Membership!]!
}

# Activity types for project activity feed
enum ActivityType {
  PROJECT_CREATED
  COMPONENT_CREATED
  COMPONENT_UPDATED
  COMPONENT_STATUS_CHANGED
  DEPENDENCY_ADDED
  DEPENDENCY_REMOVED
  MEMBER_ASSIGNED
  MEMBER_UNASSIGNED
  COMMENT_ADDED
  SPRINT_CREATED
  SPRINT_STARTED
  SPRINT_COMPLETED
  COMPONENT_ADDED_TO_SPRINT
  COMPONENT_REMOVED_FROM_SPRINT
  GITHUB_PR_OPENED
  GITHUB_PR_MERGED
  GITHUB_PR_CLOSED
  GITHUB_PR_LINKED
}

# Activity: project event log entry
# pk=PROJECT#projectId, sk=ACTIVITY#createdAt#id
type Activity {
  id: ID!
  type: ActivityType!
  projectId: String!
  userId: String!
  metadata: String
  createdAt: String!
}

# Notification types for user notifications
enum NotificationType {
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  TASK_COMMENT
  TASK_DUE_SOON
  TASK_OVERDUE
  SPRINT_STARTED
  SPRINT_ENDING
}

# Notification: user notification
# pk=USER#userId, sk=NOTIFICATION#createdAt#id
type Notification {
  id: ID!
  userId: String!
  type: NotificationType!
  title: String!
  message: String!
  componentId: String
  projectId: String
  read: Boolean!
  createdAt: String!
}

# TeamWorkflowConfig: workflow settings for a team
# pk=TEAM#teamId, sk=WORKFLOW_CONFIG
# Best practice: Direct DynamoDB GetItem for O(1) config reads
type TeamWorkflowConfig {
  id: ID!
  teamId: String!
  # WIP limits per status column
  wipLimitPlanning: Int
  wipLimitInProgress: Int
  wipLimitBlocked: Int
  wipLimitReview: Int
  # Sprint/cycle settings
  cycleEnabled: Boolean!
  cycleDurationWeeks: Int
  cycleStartDayOfWeek: Int
  cycleName: String
  backlogName: String
  # Workflow preferences
  workflowTemplate: String
  enforceEstimates: Boolean!
  autoArchiveCompleted: Boolean!
  createdAt: String
  updatedAt: String
}

input UpdateWorkflowConfigInput {
  wipLimitPlanning: Int
  wipLimitInProgress: Int
  wipLimitBlocked: Int
  wipLimitReview: Int
  cycleEnabled: Boolean
  cycleDurationWeeks: Int
  cycleStartDayOfWeek: Int
  cycleName: String
  backlogName: String
  workflowTemplate: String
  enforceEstimates: Boolean
  autoArchiveCompleted: Boolean
}

input RegisterUserInput {
  email: String!
  name: String!
}

# Input for syncing user profile from ID token claims after OAuth callback
# AWS Best Practice: Access token doesn't contain email/name claims, so frontend
# must sync these from the ID token after successful authentication
input SyncUserProfileInput {
  email: String!
  name: String!
}

type RegisterUserResult {
  success: Boolean!
  message: String!
}

# TeamMetrics: aggregated metrics for a team
# Computed via Pipeline Resolver using Query operations (not Scan) per AWS best practices
type StatusCount {
  status: ComponentStatus!
  count: Int!
}

type TeamMetrics {
  teamId: String!
  totalComponents: Int!
  statusDistribution: [StatusCount!]!
  # Breakdown by type
  epicCount: Int!
  featureCount: Int!
  storyCount: Int!
  taskCount: Int!
  bugCount: Int!
  # Sprint metrics
  totalSprints: Int!
  activeSprints: Int!
  completedSprints: Int!
}

# ============================================
# Share Code System for Guest Access
# AWS Best Practice: Cognito Identity Pool + IAM auth for guests
# ============================================

# Share code for project access (stored in DynamoDB with TTL auto-delete)
# pk=SHARE_CODE#<code>, sk=METADATA, ttl=Unix epoch for auto-expiration
type ShareCode {
  code: String!
  projectId: ID!
  teamId: ID!
  expiresAt: String!
  createdAt: String!
}

# Result of validating a share code (unauthenticated via API_KEY)
type ShareCodeInfo {
  valid: Boolean!
  projectId: ID
  projectName: String
  teamId: ID
  teamName: String
  expiresAt: String
}

# Guest session after joining with share code
# pk=GUEST#<guestId>, sk=METADATA
type GuestSession {
  guestId: ID!
  displayName: String!
  projectId: ID!
  teamId: ID!
}

input GenerateShareCodeInput {
  projectId: ID!
  # Hours until code expires (default 168 = 7 days, max 720 = 30 days)
  expiresInHours: Int
}

input GuestJoinInput {
  code: String!
  displayName: String!
}

type Query {
  # Get the current authenticated user (DynamoDB: pk=USER#sub, sk=METADATA)
  getCurrentUser: User
  # Get a user by email (DynamoDB GSI1: gsi1pk=EMAIL#email, gsi1sk=USER)
  getUserByEmail(email: String!): User
  # Get a single project by ID (DynamoDB: pk=PROJECT#id, sk=METADATA)
  getProject(id: ID!): Project
  # Get a single team by ID (DynamoDB: pk=TEAM#id, sk=METADATA)
  getTeam(id: ID!): Team
  # List teams for current user (DynamoDB GSI1: gsi1pk=USER#userId → batch get teams)
  listTeamsForUser: [TeamWithMembers!]!
  # Get team with all members (DynamoDB: GetItem TEAM#id + Query sk begins_with MEMBER#)
  getTeamWithMembers(teamId: ID!): TeamWithMembers
  # List projects for a team (DynamoDB GSI2: gsi2pk=TEAM#teamId)
  listProjectsByTeam(teamId: ID!): [Project!]!
  # List projects owned by current user (DynamoDB GSI1: gsi1pk=OWNER#userId)
  listProjectsForUser: [Project!]!
  # Get a single component by ID (DynamoDB: pk=COMPONENT#id, sk=METADATA)
  getComponent(id: ID!): Component
  # List components for a project (DynamoDB GSI1: gsi1pk=PROJECT#projectId)
  listComponentsByProject(projectId: ID!): [Component!]!
  # Get children of a component (DynamoDB GSI1 + filter by parentId)
  getComponentChildren(parentId: ID!): [Component!]!
  # Get dependencies of a component (what this component depends on)
  # DynamoDB: Query pk=COMPONENT#id, sk begins_with DEPENDS_ON#
  getDependencies(componentId: ID!): [Dependency!]!
  # Get dependents of a component (what depends on this component)
  # DynamoDB GSI1: Query gsi1pk=REQUIRED_BY#id
  getDependents(componentId: ID!): [Dependency!]!
  # Get a single sprint by ID (DynamoDB: pk=SPRINT#id, sk=METADATA)
  getSprint(id: ID!): Sprint
  # List sprints for a team (DynamoDB GSI1: gsi1pk=TEAM#teamId, sk begins_with SPRINT#)
  listSprintsByTeam(teamId: ID!): [Sprint!]!
  # Get sprint with its components (DynamoDB: GetItem + Query GSI2 gsi2pk=SPRINT#sprintId)
  getSprintWithComponents(sprintId: ID!): SprintWithComponents
  # List assignments for current user (DynamoDB GSI1: gsi1pk=USER#userId) - for MyTasksPage
  listAssignmentsForUser: [AssignmentWithComponent!]!
  # List assignees for a component (DynamoDB: Query pk=COMPONENT#id, sk begins_with ASSIGNEE#)
  listAssignmentsForComponent(componentId: ID!): [Assignment!]!
  # List activities for a project (DynamoDB: Query pk=PROJECT#projectId, sk begins_with ACTIVITY#)
  listActivitiesForProject(projectId: ID!, limit: Int): [Activity!]!
  # List notifications for current user (DynamoDB: Query pk=USER#userId, sk begins_with NOTIFICATION#)
  listNotificationsForUser(limit: Int, unreadOnly: Boolean): [Notification!]!
  # Count unread notifications for current user
  countUnreadNotifications: Int!
  # Get team workflow config (DynamoDB: GetItem pk=TEAM#teamId, sk=WORKFLOW_CONFIG)
  # Best practice: Direct DynamoDB for O(1) read
  getTeamWorkflowConfig(teamId: ID!): TeamWorkflowConfig
  # Get team metrics (Pipeline Resolver: Query projects → Query components → Aggregate)
  # Best practice: Uses Query operations on GSIs, not Scan
  getTeamMetrics(teamId: ID!): TeamMetrics!

  # ============================================
  # Share Code / Guest Access Queries
  # ============================================

  # Validate share code (unauthenticated - API_KEY auth)
  # Returns project/team info if code is valid and not expired
  validateShareCode(code: String!): ShareCodeInfo! @aws_api_key

  # Guest operations (IAM auth from Cognito Identity Pool)
  # AWS Best Practice: Temporary credentials with least-privilege IAM policy
  guestGetProject(guestId: ID!): Project @aws_iam
  guestListComponents(guestId: ID!): [Component!]! @aws_iam
  guestListAssignments(guestId: ID!): [AssignmentWithComponent!]! @aws_iam

  # List assignments for a specific team member (requires team membership - Cognito auth)
  # For owner/admin member workload view
  listAssignmentsForTeamMember(teamId: ID!, userId: ID!): [AssignmentWithComponent!]!
}

input CreateProjectInput {
  id: ID!
  teamId: ID!
  ownerId: ID!
  name: String!
