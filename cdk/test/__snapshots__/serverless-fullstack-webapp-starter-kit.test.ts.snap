        '#email': 'email',
        '#name': 'name',
        '#createdAt': 'createdAt',
        '#updatedAt': 'updatedAt',
        '#gsi1pk': 'gsi1pk',
        '#gsi1sk': 'gsi1sk'
      },
      expressionValues: util.dynamodb.toMapValues({
        ':id': userId,
        ':email': email,
        ':name': name,
