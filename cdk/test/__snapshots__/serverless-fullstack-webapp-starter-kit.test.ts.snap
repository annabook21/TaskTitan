    "AppSyncGraphqlApiSchemaC2E94F39": {
      "Properties": {
        "ApiId": {
          "Fn::GetAtt": [
            "AppSyncGraphqlApi48248BEB",
            "ApiId",
          ],
        },
        "Definition": "# Phase 2/3: AppSync GraphQL API (main API; CloudFront + S3 frontend, no App Runner)
# Auth: Cognito User Pools. Data: DynamoDB (same table as ElectroDB) + Lambda (Bedrock).
# Region: us-east-2.

type User {
  id: ID!
  # Email is nullable to handle edge cases where user record exists but email wasn't migrated
  email: String
  name: String
  avatarUrl: String
  createdAt: String
  updatedAt: String
  # Timestamp-based "Read Until" marker for O(1) mark-all-as-read (AWS best practice)
  # Notifications with createdAt <= notificationsReadUntil are considered read
  notificationsReadUntil: String
}

type Project @aws_cognito_user_pools @aws_iam {
  id: ID!
  name: String!
  description: String
  teamId: String!
  ownerId: String!
  createdAt: String
  updatedAt: String
}

type Team {
  id: ID!
  name: String!
  description: String
  # Atomic counter for team member count (AWS best practice for frequently accessed counts)
  memberCount: Int
  createdAt: String
  updatedAt: String
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
  GUEST
}

enum ComponentType {
  EPIC
  FEATURE
  STORY
  TASK
  BUG
}

enum ComponentStatus {
  PLANNING
  IN_PROGRESS
  BLOCKED
  REVIEW
  COMPLETED
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

# Sprint: time-boxed iteration for a team
# pk=SPRINT#id, sk=METADATA, gsi1pk=TEAM#teamId, gsi1sk=SPRINT#id
type Sprint {
  id: ID!
  teamId: String!
  name: String!
  goal: String
  status: SprintStatus!
  startDate: String
  endDate: String
  createdAt: String
  updatedAt: String
}

type SprintWithComponents {
  sprint: Sprint!
  components: [Component!]!
}

type Component @aws_cognito_user_pools @aws_iam {
  id: ID!
  name: String!
  description: String
  type: ComponentType!
  projectId: String!
  parentId: String
  sprintId: String
  status: ComponentStatus!
  priority: Int
  estimatedHours: Float
  actualHours: Float
  dueDate: String
  owner: String
  tags: [String!]
  # AI-generated acceptance criteria from refinement
  acceptanceCriteria: [String!]
  createdAt: String
  updatedAt: String
  # Kanban: Timestamp when work started (for cycle time calculation)
  # Cycle Time = completedAt - startedAt (Little's Law)
  startedAt: String
  # Shape Up: Manual hill chart position (0-100)
  # 0-50 = "figuring things out" (uphill), 51-100 = "making it happen" (downhill)
  hillPhase: Int
}

# =============================================================================
# Real-time Component Updates (Subscriptions)
# =============================================================================

enum ComponentChangeAction {
  CREATED
  UPDATED
  DELETED
}

# Published component change event for real-time dashboard updates
type ComponentChange @aws_cognito_user_pools {
  projectId: ID!
  componentId: ID!
  action: ComponentChangeAction!
  # Full component data (null for DELETED action)
  component: Component
}

# Input for publishing component changes (mirrors Component type)
input ComponentInput {
  id: ID!
  name: String!
  description: String
  type: ComponentType!
  projectId: String!
  parentId: String
  sprintId: String
  status: ComponentStatus!
  priority: Int
  estimatedHours: Float
  actualHours: Float
  dueDate: String
  owner: String
  tags: [String!]
  acceptanceCriteria: [String!]
  createdAt: String
  updatedAt: String
  startedAt: String
  hillPhase: Int
}

type Membership {
  id: ID!
  userId: String!
  teamId: String!
  role: MemberRole!
  joinedAt: String
  title: String
  hoursPerDay: Int
  availability: Int
  user: User
  # Guest-specific fields (populated when role=GUEST)
  displayName: String # For guest members (when userId starts with "GUEST#")
  projectId: String # For guest members from project share codes
  isGuest: Boolean
  guestName: String
}

# Dependency represents a "depends on" relationship between components
# pk=COMPONENT#fromId, sk=DEPENDS_ON#toId, gsi1pk=REQUIRED_BY#toId, gsi1sk=COMPONENT#fromId
type Dependency {
  fromComponentId: ID!
  toComponentId: ID!
  createdAt: String
}

# Assignment represents a user assigned to a component
# pk=COMPONENT#componentId, sk=ASSIGNEE#userId, gsi1pk=USER#userId, gsi1sk=ASSIGNMENT#componentId
type Assignment @aws_cognito_user_pools @aws_iam {
  id: ID!
  componentId: ID!
  userId: ID!
  assignedAt: String!
  user: User
  component: Component
}

# For MyTasksPage - returns assignments with full component details
type AssignmentWithComponent @aws_cognito_user_pools @aws_iam {
  assignment: Assignment!
  component: Component!
}

type TeamWithMembers {
  team: Team!
  members: [Membership!]!
}

# Activity types for project activity feed
enum ActivityType {
  PROJECT_CREATED
  COMPONENT_CREATED
  COMPONENT_UPDATED
  COMPONENT_STATUS_CHANGED
  DEPENDENCY_ADDED
  DEPENDENCY_REMOVED
  MEMBER_ASSIGNED
  MEMBER_UNASSIGNED
  COMMENT_ADDED
  SPRINT_CREATED
  SPRINT_STARTED
  SPRINT_COMPLETED
  SPRINT_REOPENED
  COMPONENT_ADDED_TO_SPRINT
  COMPONENT_REMOVED_FROM_SPRINT
  GITHUB_PR_OPENED
  GITHUB_PR_MERGED
  GITHUB_PR_CLOSED
  GITHUB_PR_LINKED
}

# Activity: project event log entry
# pk=PROJECT#projectId, sk=ACTIVITY#createdAt#id
type Activity {
  id: ID!
  type: ActivityType!
  projectId: String!
  userId: String!
  metadata: String
  createdAt: String!
}

# Notification types for user notifications
enum NotificationType {
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  TASK_COMMENT
  TASK_DUE_SOON
  TASK_OVERDUE
  SPRINT_STARTED
  SPRINT_ENDING
}

# Notification: user notification
# pk=USER#userId, sk=NOTIFICATION#createdAt#id
type Notification {
  id: ID!
  userId: String!
  type: NotificationType!
  title: String!
  message: String!
  componentId: String
  projectId: String
  read: Boolean!
  createdAt: String!
}

# ============================================
# Comments System
# ============================================

# Author type for comments (USER or GUEST)
enum AuthorType {
  USER
  GUEST
}

# Comment on a component
# pk=COMPONENT#componentId, sk=COMMENT#createdAt#id
type Comment @aws_cognito_user_pools @aws_iam {
  id: ID!
  componentId: ID!
  projectId: ID!
  authorId: ID!
  authorType: AuthorType!
  authorName: String!
  content: String!
  mentions: [String!]
  createdAt: String!
}

# Team member suggestion for @mentions autocomplete
type TeamMemberSuggestion {
  id: ID!
  name: String!
  isGuest: Boolean!
}

# ============================================
# Guest Notifications
# ============================================

# Notification types for guests (separate from user notifications)
enum GuestNotificationType {
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_STATUS_CHANGED
  TASK_MENTIONED
}

# Guest notification: notifications for guests
# pk=GUEST#guestId, sk=NOTIFICATION#createdAt#id
type GuestNotification @aws_iam {
  id: ID!
  guestId: ID!
  type: GuestNotificationType!
  title: String!
  message: String!
  componentId: String
  projectId: String
  read: Boolean!
  createdAt: String!
}

# Activity with author information for guest activity feed
type ActivityWithAuthor @aws_iam {
  id: ID!
  type: ActivityType!
  projectId: String!
  authorId: String!
  authorName: String
  authorType: AuthorType!
  metadata: String
  createdAt: String!
}

# TeamWorkflowConfig: workflow settings for a team
# pk=TEAM#teamId, sk=WORKFLOW_CONFIG
# Best practice: Direct DynamoDB GetItem for O(1) config reads
type TeamWorkflowConfig {
  id: ID!
  teamId: String!
  # WIP limits per status column
  wipLimitPlanning: Int
  wipLimitInProgress: Int
  wipLimitBlocked: Int
  wipLimitReview: Int
  # Sprint/cycle settings
  cycleEnabled: Boolean!
  cycleDurationWeeks: Int
  cycleStartDayOfWeek: Int
  cycleName: String
  backlogName: String
  # Workflow preferences
  workflowTemplate: String
  enforceEstimates: Boolean!
  autoArchiveCompleted: Boolean!
  createdAt: String
  updatedAt: String
}

input UpdateWorkflowConfigInput {
  wipLimitPlanning: Int
  wipLimitInProgress: Int
  wipLimitBlocked: Int
  wipLimitReview: Int
  cycleEnabled: Boolean
  cycleDurationWeeks: Int
  cycleStartDayOfWeek: Int
  cycleName: String
  backlogName: String
  workflowTemplate: String
  enforceEstimates: Boolean
  autoArchiveCompleted: Boolean
}

input RegisterUserInput {
  email: String!
  name: String!
}

# Input for syncing user profile from ID token claims after OAuth callback
# AWS Best Practice: Access token doesn't contain email/name claims, so frontend
# must sync these from the ID token after successful authentication
input SyncUserProfileInput {
  email: String!
  name: String!
}

type RegisterUserResult @aws_api_key @aws_cognito_user_pools {
  success: Boolean!
  message: String!
}

# TeamMetrics: aggregated metrics for a team
# Computed via Pipeline Resolver using Query operations (not Scan) per AWS best practices
type StatusCount {
  status: ComponentStatus!
  count: Int!
}

type TeamMetrics {
  teamId: String!
  totalComponents: Int!
  statusDistribution: [StatusCount!]!
  # Breakdown by type
  epicCount: Int!
  featureCount: Int!
  storyCount: Int!
  taskCount: Int!
  bugCount: Int!
  # Sprint metrics
  totalSprints: Int!
  activeSprints: Int!
  completedSprints: Int!
}

# ============================================
# Share Code System for Guest Access
# AWS Best Practice: Cognito Identity Pool + IAM auth for guests
# ============================================

# Share code for project access (stored in DynamoDB with TTL auto-delete)
# pk=SHARE_CODE#<code>, sk=METADATA, ttl=Unix epoch for auto-expiration
# GSI: gsi1pk=PROJECT#<projectId>, gsi1sk=SHARE_CODE#<code> (for listing codes by project)
type ShareCode {
  code: String!
  projectId: ID!
  projectName: String        # Denormalized for display without extra query
  teamId: ID!
  teamName: String           # Denormalized for display without extra query
  expiresAt: String!
  createdAt: String!
  createdBy: ID!             # User ID who created the code
}

# Result of validating a share code (unauthenticated via API_KEY)
type ShareCodeInfo @aws_api_key {
  valid: Boolean!
  projectId: ID
  projectName: String
  teamId: ID
  teamName: String
  expiresAt: String
}

# Guest session after joining with share code
# guestId is the Cognito Identity Pool identity ID for security validation
type GuestSession @aws_iam {
  guestId: ID!
  displayName: String!
  projectId: ID!
  projectName: String        # Denormalized for display
  teamId: ID!
  teamName: String           # Denormalized for display
}

input GenerateShareCodeInput {
  projectId: ID!
  projectName: String       # Denormalized for display (optional)
  teamId: ID                # Team ID for the project (optional, derived from project)
  teamName: String          # Denormalized for display (optional)
  # Hours until code expires (default 168 = 7 days, max 720 = 30 days)
  expiresInHours: Int
}

input GuestJoinInput {
  code: String!
  displayName: String!
}

# Input for guest joining a team with invite code (IAM auth)
input GuestJoinTeamInput {
  code: String!
  displayName: String!
}

# Guest team session after joining with team invite code
# guestId is the Cognito Identity Pool identity ID for security validation
type GuestTeamSession @aws_iam {
  guestId: ID!
  displayName: String!
  teamId: ID!
  teamName: String
  role: MemberRole!
}

# ============================================
# Team Invite Code System (Authenticated Users)
# ============================================

# Team invite code for inviting authenticated users to join a team
# pk=TEAM_INVITE#<code>, sk=METADATA, ttl=Unix epoch for auto-expiration
# GSI: gsi1pk=TEAM#<teamId>, gsi1sk=TEAM_INVITE#<code> (for listing codes by team)
type TeamInviteCode {
  code: String!
  teamId: ID!
  teamName: String!
  role: MemberRole!
  expiresAt: String!
  createdAt: String!
  createdBy: ID!
  usageCount: Int!
  maxUses: Int  # null = unlimited
}

# Result of migrating guest data to authenticated user
type MigrationResult {
  success: Boolean!
  migratedAssignments: Int!
  migratedComments: Int!
  message: String
}

input GenerateTeamInviteInput {
  teamId: ID!
  role: MemberRole         # Default: MEMBER
  expiresInHours: Int      # Default: 168 (7 days)
  maxUses: Int             # Optional: limit uses (null = unlimited)
}

type TeamInviteValidation @aws_api_key @aws_cognito_user_pools {
  valid: Boolean!
  teamId: ID
  teamName: String
  role: MemberRole
  message: String
}

type Query {
  # Get the current authenticated user (DynamoDB: pk=USER#sub, sk=METADATA)
  getCurrentUser: User
  # Get a user by email (DynamoDB GSI1: gsi1pk=EMAIL#email, gsi1sk=USER)
  getUserByEmail(email: String!): User
  # Get a single project by ID (DynamoDB: pk=PROJECT#id, sk=METADATA)
  getProject(id: ID!): Project
  # Get a single team by ID (DynamoDB: pk=TEAM#id, sk=METADATA)
  getTeam(id: ID!): Team
  # List teams for current user (DynamoDB GSI1: gsi1pk=USER#userId → batch get teams)
  listTeamsForUser: [TeamWithMembers!]!
  # Get team with all members (DynamoDB: GetItem TEAM#id + Query sk begins_with MEMBER#)
  getTeamWithMembers(teamId: ID!): TeamWithMembers
  # List projects for a team (DynamoDB GSI2: gsi2pk=TEAM#teamId)
  listProjectsByTeam(teamId: ID!): [Project!]!
  # List projects owned by current user (DynamoDB GSI1: gsi1pk=OWNER#userId)
  listProjectsForUser: [Project!]!
  # Get a single component by ID (DynamoDB: pk=COMPONENT#id, sk=METADATA)
  getComponent(id: ID!): Component
  # List components for a project (DynamoDB GSI1: gsi1pk=PROJECT#projectId)
  listComponentsByProject(projectId: ID!): [Component!]!
  # Get children of a component (DynamoDB GSI1 + filter by parentId)
  getComponentChildren(parentId: ID!): [Component!]!
  # Get dependencies of a component (what this component depends on)
  # DynamoDB: Query pk=COMPONENT#id, sk begins_with DEPENDS_ON#
  getDependencies(componentId: ID!): [Dependency!]!
  # Get dependents of a component (what depends on this component)
  # DynamoDB GSI1: Query gsi1pk=REQUIRED_BY#id
  getDependents(componentId: ID!): [Dependency!]!
  # Get a single sprint by ID (DynamoDB: pk=SPRINT#id, sk=METADATA)
  getSprint(id: ID!): Sprint
  # List sprints for a team (DynamoDB GSI1: gsi1pk=TEAM#teamId, sk begins_with SPRINT#)
  listSprintsByTeam(teamId: ID!): [Sprint!]!
  # Get sprint with its components (DynamoDB: GetItem + Query GSI2 gsi2pk=SPRINT#sprintId)
  getSprintWithComponents(sprintId: ID!): SprintWithComponents
  # List assignments for current user (DynamoDB GSI1: gsi1pk=USER#userId) - for MyTasksPage
  listAssignmentsForUser: [AssignmentWithComponent!]!
  # List assignees for a component (DynamoDB: Query pk=COMPONENT#id, sk begins_with ASSIGNEE#)
  listAssignmentsForComponent(componentId: ID!): [Assignment!]!
  # List activities for a project (DynamoDB: Query pk=PROJECT#projectId, sk begins_with ACTIVITY#)
  listActivitiesForProject(projectId: ID!, limit: Int): [Activity!]!
  # List notifications for current user (DynamoDB: Query pk=USER#userId, sk begins_with NOTIFICATION#)
  listNotificationsForUser(limit: Int, unreadOnly: Boolean): [Notification!]!
  # Count unread notifications for current user
  countUnreadNotifications: Int!
  # Get team workflow config (DynamoDB: GetItem pk=TEAM#teamId, sk=WORKFLOW_CONFIG)
  # Best practice: Direct DynamoDB for O(1) read
  getTeamWorkflowConfig(teamId: ID!): TeamWorkflowConfig
  # Get team metrics (Pipeline Resolver: Query projects → Query components → Aggregate)
  # Best practice: Uses Query operations on GSIs, not Scan
  getTeamMetrics(teamId: ID!): TeamMetrics!

  # ============================================
  # Share Code / Guest Access Queries
  # ============================================

  # Validate share code (unauthenticated - API_KEY auth)
  # Returns project/team info if code is valid and not expired
  validateShareCode(code: String!): ShareCodeInfo! @aws_api_key

  # Guest operations (IAM auth from Cognito Identity Pool)
  # AWS Best Practice: Temporary credentials with least-privilege IAM policy
  # guestId must match caller's cognitoIdentityId (verified in resolver)
  guestGetProject(guestId: ID!, projectId: ID!): Project @aws_iam
  guestListComponents(guestId: ID!, projectId: ID!): [Component!]! @aws_iam
  guestListAssignments(guestId: ID!, projectId: ID!): [AssignmentWithComponent!]! @aws_iam
  # List all projects in a team for team-only guests (IAM auth)
  # Verifies guest is a member of the team
  guestListTeamProjects(guestId: ID!, teamId: ID!): [Project!]! @aws_iam

  # List assignments for a specific team member (requires team membership - Cognito auth)
  # For owner/admin member workload view
  listAssignmentsForTeamMember(teamId: ID!, userId: ID!): [AssignmentWithComponent!]!

  # List active share codes for a project (owner/admin only - Cognito auth)
  # Used by project owners to manage their share codes
  listShareCodesForProject(projectId: ID!): [ShareCode!]!

  # ============================================
  # Comments Queries
  # ============================================

  # List comments for a component (Cognito auth)
  # DynamoDB: Query pk=COMPONENT#componentId, sk begins_with COMMENT#
  listCommentsForComponent(componentId: ID!, limit: Int): [Comment!]!

  # Guest: List comments for a component they can access (IAM auth)
  # Verifies guest has access to the component's project
  guestListComments(guestId: ID!, componentId: ID!, limit: Int): [Comment!]! @aws_iam

  # Search team members for @mentions autocomplete (Cognito auth)
  # Returns users and guests in the team matching the query
  searchTeamMembersForMention(teamId: ID!, query: String!): [TeamMemberSuggestion!]!

  # ============================================
  # Guest Activity Feed & Notifications Queries
  # ============================================

  # Guest: List activity on assigned components (IAM auth)
  # Returns activity where the guest is assigned to the component
  guestListActivityFeed(guestId: ID!, projectId: ID!, limit: Int): [ActivityWithAuthor!]! @aws_iam

  # Guest: List notifications (IAM auth)
  guestListNotifications(guestId: ID!, limit: Int): [GuestNotification!]! @aws_iam

  # Guest: Count unread notifications (IAM auth)
  guestCountUnreadNotifications(guestId: ID!): Int! @aws_iam

  # ============================================
  # Team Invite Code Queries
  # ============================================

  # Validate team invite code (API key allowed for guest access)
  validateTeamInvite(code: String!): TeamInviteValidation! @aws_api_key @aws_cognito_user_pools

  # List active invite codes for a team (owner/admin only)
  listTeamInviteCodes(teamId: ID!): [TeamInviteCode!]!
}

input CreateProjectInput {
  id: ID!
  teamId: ID!
  ownerId: ID!
  name: String!
  description: String
}

input UpdateProjectInput {
  name: String
  description: String
}

input CreateTeamInput {
  id: ID!
  name: String!
  description: String
}

input UpdateTeamInput {
  name: String
  description: String
}

input AddTeamMemberInput {
  teamId: ID!
  userId: ID!
  role: MemberRole!
  title: String
}

input UpdateMemberRoleInput {
  teamId: ID!
  userId: ID!
  role: MemberRole!
}

input CreateComponentInput {
  id: ID!
  projectId: ID!
  name: String!
  description: String
  type: ComponentType!
  parentId: ID
  status: ComponentStatus
  priority: Int
  estimatedHours: Float
  dueDate: String
  owner: String
  tags: [String!]
  # Kanban: Timestamp when work started
  startedAt: String
  # Shape Up: Initial hill chart position (0-100)
  hillPhase: Int
}

input UpdateComponentInput {
  name: String
  description: String
  type: ComponentType
  parentId: ID
  sprintId: ID
  status: ComponentStatus
  priority: Int
  estimatedHours: Float
  actualHours: Float
  dueDate: String
  owner: String
  tags: [String!]
  # Kanban: Timestamp when work started (set automatically when status -> IN_PROGRESS)
  startedAt: String
  # Shape Up: Manual hill chart position (0-100, user-draggable)
  hillPhase: Int
  # AI-generated acceptance criteria from refinement
  acceptanceCriteria: [String!]
}

input CreateSprintInput {
  id: ID!
  teamId: ID!
  name: String!
  goal: String
  startDate: String
  endDate: String
}

input UpdateSprintInput {
  name: String
  goal: String
  startDate: String
  endDate: String
}

# ============================================
# AI Generation Types (Full Parity with Next.js)
# ============================================

# Input for generating a full project plan with workflow awareness
input GenerateFullPlanInput {
  projectId: ID!
  # Generate epic groupings (Scrum only, optional backlog organization)
  generateEpics: Boolean
}

# Generated component from AI (before applying to database)
input GeneratedComponentInput {
  name: String!
  description: String!
  type: ComponentType!
  estimatedHours: Float!
  priority: Int!
  # Component names this depends on (resolved to IDs during apply)
  suggestedDependencies: [String!]!
  # Parent component name for hierarchy (resolved to ID during apply)
  parentName: String
  # Acceptance criteria for the component
  acceptanceCriteria: [String!]
}

# Generated sprint from AI
input GeneratedSprintInput {
  name: String!
  goal: String!
  durationWeeks: Int!
  # Component names assigned to this sprint
  componentNames: [String!]!
  capacity: Float
}

# Generated epic grouping from AI
input GeneratedEpicInput {
  name: String!
  description: String!
  # Component names grouped under this epic
  componentNames: [String!]!
}

# Input for applying a generated plan to the database
input ApplyFullPlanInput {
  projectId: ID!
  components: [GeneratedComponentInput!]!
  enhancedDescription: String
  sprints: [GeneratedSprintInput!]
  epics: [GeneratedEpicInput!]
}

# Input for refining a single component via chat
input RefineComponentInput {
  projectId: ID!
  currentComponent: NaturalLanguageComponentInput!
  refinementRequest: String!
}

# Input for guest refining a component via chat (IAM auth)
# guestId is verified against cognitoIdentityId
# componentId is used to fetch component details and verify assignment
input GuestRefineComponentInput {
  guestId: ID!
  componentId: ID!
  refinementRequest: String!
}

# Input for guest updating a component (IAM auth)
# Only allowed for components the guest is assigned to
# Used to apply AI refinement suggestions
input GuestUpdateComponentInput {
  guestId: ID!
  componentId: ID!
  name: String
  description: String
  type: ComponentType
  estimatedHours: Float
  priority: Int
  acceptanceCriteria: [String!]
}

# Component structure for natural language operations
input NaturalLanguageComponentInput {
  name: String!
  description: String!
  type: ComponentType!
  estimatedHours: Float!
  priority: Int!
  suggestedDependencies: [String!]!
  reasoning: String!
  acceptanceCriteria: [String!]
}

# Input for refining an entire plan via chat
input RefineBulkPlanInput {
  projectId: ID!
  currentPlan: CurrentPlanInput!
  refinementRequest: String!
}

# Current plan state for bulk refinement
input CurrentPlanInput {
  components: [GeneratedComponentInput!]!
  sprints: [GeneratedSprintInput!]
  epics: [GeneratedEpicInput!]
}

# Input for creating a component from natural language
input SmartComponentInput {
  projectId: ID!
  userInput: String!
  parentComponentId: ID
}

# Input for AI sprint planning
input PlanSprintInput {
  teamId: ID!
  sprintId: ID
  capacityHours: Float!
}

# Output types for AI operations
# Both IAM (Lambda publishes via IAM) and Cognito (frontend subscribes via user pool) need access

type GeneratedComponentOutput @aws_iam @aws_cognito_user_pools {
  name: String!
  description: String!
  type: ComponentType!
  estimatedHours: Float!
  priority: Int!
  suggestedDependencies: [String!]!
  parentName: String
  acceptanceCriteria: [String!]
}

type GeneratedSprintOutput @aws_iam @aws_cognito_user_pools {
  name: String!
  goal: String!
  durationWeeks: Int!
  componentNames: [String!]!
  capacity: Float
}

type GeneratedEpicOutput @aws_iam @aws_cognito_user_pools {
  name: String!
  description: String!
  componentNames: [String!]!
}

input FullPlanResultInput {
  components: [GeneratedComponentInput!]!
  summary: String!
  enhancedDescription: String
  sprints: [GeneratedSprintInput!]
  epics: [GeneratedEpicInput!]
}

# Result of full plan generation
type FullPlanResult @aws_iam @aws_cognito_user_pools {
  components: [GeneratedComponentOutput!]!
  summary: String!
  enhancedDescription: String
  # Sprints (Scrum workflow only)
  sprints: [GeneratedSprintOutput!]
  # Epic groupings (optional)
  epics: [GeneratedEpicOutput!]
}

# Result of applying a plan to database
type ApplyPlanResult {
  created: Int!
  dependencies: Int!
  sprints: Int!
  epics: Int!
  componentIds: [ID!]!
  sprintIds: [ID!]!
}

# Result of component refinement
type RefineComponentResult @aws_iam @aws_cognito_user_pools {
  component: GeneratedComponentOutput!
  explanation: String!
  suggestedFollowUps: [String!]!
}

# Changed item in bulk refinement
type ChangedItem {
  type: String!
  name: String!
  change: String!
}

# Result of bulk plan refinement
type RefineBulkPlanResult {
  components: [GeneratedComponentOutput!]!
  sprints: [GeneratedSprintOutput!]
  epics: [GeneratedEpicOutput!]
  explanation: String!
  changedItems: [ChangedItem!]!
  suggestedFollowUps: [String!]!
}

# Result of smart component creation
type SmartComponentResult {
  component: GeneratedComponentOutput!
  reasoning: String!
  suggestedFollowUps: [String!]!
}

# Result of AI sprint planning
type SprintPlanResult {
  selectedComponentIds: [ID!]!
  totalHours: Float!
  reasoning: String!
  warnings: [String!]!
}

# ============================================
# Phase 1: Template Application Types
# ============================================

enum ComponentTemplateType {
  CRUD_FEATURE
  REST_API
  USER_AUTH
  FORM_WITH_VALIDATION
  DATA_DASHBOARD
  FILE_UPLOAD
  SEARCH_FILTER
  NOTIFICATION_SYSTEM
  PAYMENT_INTEGRATION
  ADMIN_PANEL
}

input ApplyTemplateInput {
  template: ComponentTemplateType!
  entityName: String!
  projectName: String!
  projectId: ID!
  additionalRequirements: String
}

type TemplateComponentOutput {
  name: String!
  description: String!
  type: ComponentType!
  estimatedHours: Float!
  priority: Int!
  suggestedDependencies: [String!]!
}

type ApplyTemplateResult {
  components: [TemplateComponentOutput!]!
  implementationNotes: String!
  techStackRecommendations: String
}

# ============================================
# Phase 2: Component Breakdown Types
# ============================================

input SuggestBreakdownInput {
  componentId: ID!
  projectId: ID!
}

type BreakdownSuggestion {
  name: String!
  description: String!
  type: ComponentType!
  estimatedHours: Float!
  priority: Int!
  suggestedDependencies: [String!]!
  acceptanceCriteria: [String!]
}

type SuggestBreakdownResult {
  suggestions: [BreakdownSuggestion!]!
  reasoning: String!
  recommendedApproach: String!
}

# ============================================
# Phase 3: Wireframe Generation Types
# ============================================

input GenerateWireframeInput {
  componentId: ID!
}

type GenerateWireframeResult {
  html: String!
  componentName: String!
}

# ============================================
# Phase 4: Import Analysis Types
# ============================================

input AnalyzeImportInput {
  headers: [String!]!
  sampleRows: [String!]!
  projectId: ID!
}

type ColumnMappingOutput {
  sourceColumn: String!
  targetField: String
  confidence: Float!
}

type AnalyzeImportResult {
  mappings: [ColumnMappingOutput!]!
  detectedFormat: String!
  suggestions: [String!]!
  warnings: [String!]!
}

input ColumnMappingInput {
  sourceColumn: String!
  targetField: String
}

input CleanupImportInput {
  rows: [String!]!
  mappings: [ColumnMappingInput!]!
}

type CleanedRowOutput {
  original: String!
  cleaned: String!
  changes: [String!]!
}

type CleanupImportResult {
  rows: [CleanedRowOutput!]!
  summary: String!
  totalChanges: Int!
}

# ============================================
# Phase 5: Retrospective Generation Types
# ============================================

input GenerateRetrospectiveInput {
  sprintId: ID!
  applyAdjustments: Boolean
}

type EstimationInsights {
  estimationAccuracy: String!
  velocityTrend: String!
  recommendations: [String!]!
}

type AdjustedEstimate {
  componentId: ID!
  componentName: String!
  originalEstimate: Float!
  adjustedEstimate: Float!
  reasoning: String!
}

type GenerateRetrospectiveResult {
  summary: String!
  insights: EstimationInsights!
  adjustedEstimates: [AdjustedEstimate!]!
  suggestedActions: [String!]!
  adjustmentsApplied: Boolean!
}

# =============================================================================
# Async AI Generation Types (must be defined before Mutation that uses them)
# =============================================================================

enum AIJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

type AIJob {
  sessionId: ID!
  status: AIJobStatus!
  createdAt: String!
}

# AIProgress type needs both IAM (for Lambda publishAIProgress) and Cognito (for frontend subscription)
type AIProgress @aws_iam @aws_cognito_user_pools {
  sessionId: ID!
  progress: Int!
  message: String!
  status: AIJobStatus!
  result: FullPlanResult
  error: String
}

input StartAIGenerationInput {
  projectId: ID!
  generateEpics: Boolean
}

# AI generation: Lambda (Bedrock) invoked by AppSync; returns generated text.
type Mutation {
  # User registration (unauthenticated - uses AdminCreateUser, sends temp password via email)
  # AWS best practice: Lambda resolver for admin SDK operations
  registerUser(input: RegisterUserInput!): RegisterUserResult! @aws_api_key

  # Sync user profile from ID token claims after OAuth callback
  # AWS Best Practice: Access token (used by AppSync) doesn't contain email/name,
  # so frontend extracts from ID token and syncs here
  # MUST be called with fresh OAuth tokens immediately after authentication
  syncUserProfile(input: SyncUserProfileInput!): User! @aws_cognito_user_pools

  # Delete current user's account data (DynamoDB records, team memberships)
  # Note: Does not delete Cognito user - user should use account settings for full deletion
  deleteCurrentUser: Boolean! @aws_cognito_user_pools

  # =============================================================================
  # Async AI Generation (bypasses 30s timeout)
  # =============================================================================
  # Start async AI generation - returns sessionId immediately, client subscribes for updates
  startAIGeneration(input: StartAIGenerationInput!): AIJob!
  # Internal: Lambda publishes progress updates (triggers subscription)
  # Uses IAM auth - only callable by Lambda with appsync:GraphQL permission
  publishAIProgress(sessionId: ID!, progress: Int!, message: String!, status: AIJobStatus!, result: FullPlanResultInput, error: String): AIProgress! @aws_iam

  # =============================================================================
  # Real-time Component Updates
  # =============================================================================
  # Publish component change event (triggers onComponentChange subscription)
  # Called by frontend after component CRUD operations to notify other users
  publishComponentChange(
    projectId: ID!
    componentId: ID!
    action: ComponentChangeAction!
    component: ComponentInput
  ): ComponentChange! @aws_cognito_user_pools

  # Legacy: Simple AI generation (returns raw string)
  generateComponentViaAI(projectId: ID!, prompt: String!): String
  # Full AI Plan Generation (workflow-aware: Scrum generates sprints, Kanban generates flat items)
  # NOTE: This has 30s timeout - use startAIGeneration for production
  generateFullPlan(input: GenerateFullPlanInput!): FullPlanResult!
  # Apply generated plan atomically (creates components, dependencies, sprints, assigns to epics)
  applyFullPlan(input: ApplyFullPlanInput!): ApplyPlanResult!
  # Refine single component via chat
  refineComponent(input: RefineComponentInput!): RefineComponentResult!
  # Refine entire plan via chat
  refineBulkPlan(input: RefineBulkPlanInput!): RefineBulkPlanResult!
  # Smart component: natural language -> structured component preview
  createSmartComponent(input: SmartComponentInput!): SmartComponentResult!
  # AI sprint planning: suggest components for a sprint based on capacity and priorities
  planSprint(input: PlanSprintInput!): SprintPlanResult!
  # Template application: 10 predefined project templates
  applyTemplate(input: ApplyTemplateInput!): ApplyTemplateResult!
  # Component breakdown: hierarchical decomposition suggestions
  suggestBreakdown(input: SuggestBreakdownInput!): SuggestBreakdownResult!
  # Wireframe generation: HTML wireframe for UI components
  generateWireframe(input: GenerateWireframeInput!): GenerateWireframeResult!
  # Import analysis: AI-powered CSV/JSON column mapping
  analyzeImportData(input: AnalyzeImportInput!): AnalyzeImportResult!
  # Import cleanup: AI-powered data normalization
  cleanupImportData(input: CleanupImportInput!): CleanupImportResult!
  # Retrospective generation: sprint analysis with estimate adjustment
  generateRetrospective(input: GenerateRetrospectiveInput!): GenerateRetrospectiveResult!
  # Project mutations
  createProject(input: CreateProjectInput!): Project!
  updateProject(id: ID!, input: UpdateProjectInput!): Project!
  deleteProject(id: ID!): Boolean!
  # Team mutations
  createTeam(input: CreateTeamInput!): TeamWithMembers!
  updateTeam(teamId: ID!, input: UpdateTeamInput!): Team!
  deleteTeam(teamId: ID!): Boolean!
  addTeamMember(input: AddTeamMemberInput!): Membership!
  removeTeamMember(teamId: ID!, userId: ID!): Boolean!
  updateMemberRole(input: UpdateMemberRoleInput!): Membership!
  # Component mutations
  createComponent(input: CreateComponentInput!): Component!
  updateComponent(id: ID!, input: UpdateComponentInput!): Component!
  deleteComponent(id: ID!): Boolean!
  # Dependency mutations (TransactWriteItems with ConditionCheck to verify both components exist)
  addDependency(fromComponentId: ID!, toComponentId: ID!): Dependency!
  removeDependency(fromComponentId: ID!, toComponentId: ID!): Boolean!
  # Sprint mutations
  createSprint(input: CreateSprintInput!): Sprint!
  updateSprint(id: ID!, input: UpdateSprintInput!): Sprint!
  deleteSprint(id: ID!): Boolean!
  startSprint(id: ID!): Sprint!
  completeSprint(id: ID!): Sprint!
  reopenSprint(id: ID!): Sprint!
  # Assign/remove components from sprints (updates component.sprintId + GSI2)
  assignComponentToSprint(componentId: ID!, sprintId: ID!): Component!
  removeComponentFromSprint(componentId: ID!): Component!
  # Assign/unassign users to/from components
  assignUserToComponent(componentId: ID!, userId: ID!): Assignment!
  unassignUserFromComponent(componentId: ID!, userId: ID!): Boolean!
  # Mark notification as read
  markNotificationRead(notificationId: ID!): Notification!
  # Mark all notifications as read for current user
  markAllNotificationsRead: Int!
  # Update team workflow config (DynamoDB: UpdateItem/PutItem)
  # Best practice: Direct DynamoDB for O(1) write
  updateTeamWorkflowConfig(teamId: ID!, input: UpdateWorkflowConfigInput!): TeamWorkflowConfig!

  # ============================================
  # Share Code / Guest Access Mutations
  # ============================================

  # Owner generates a share code for their project (Cognito auth required)
  # Creates SHARE_CODE#<code> item in DynamoDB with TTL for auto-expiration
  generateShareCode(input: GenerateShareCodeInput!): ShareCode!

  # Owner revokes a share code (Cognito auth required)
  revokeShareCode(code: String!): Boolean!

  # Guest joins project with share code (IAM auth from Identity Pool)
  # Creates GUEST#<guestId> and TEAM#<teamId>/MEMBER#GUEST#<guestId> items
  guestJoinProject(input: GuestJoinInput!): GuestSession! @aws_iam

  # Guest self-assigns to a component (IAM auth)
  # Only allowed if component is in guest's project
  guestAssignSelf(guestId: ID!, componentId: ID!): Assignment! @aws_iam

  # Guest unassigns self from a component (IAM auth)
  # Only allowed if guest owns the assignment
  guestUnassignSelf(guestId: ID!, componentId: ID!): Boolean! @aws_iam

  # Guest updates component status (IAM auth)
  # Only allowed on components the guest is assigned to
  guestUpdateStatus(guestId: ID!, componentId: ID!, status: ComponentStatus!): Component! @aws_iam

  # Guest refines component via AI chat (IAM auth)
  # Only allowed on components the guest is assigned to
  # Uses existing chat-refinement-generator for AI processing
  guestRefineComponent(input: GuestRefineComponentInput!): RefineComponentResult! @aws_iam

  # Guest updates component fields (IAM auth)
  # Only allowed on components the guest is assigned to
  # Used to apply AI refinement suggestions
  guestUpdateComponent(input: GuestUpdateComponentInput!): Component! @aws_iam

  # ============================================
  # Comments Mutations
  # ============================================

  # Create a comment on a component (Cognito auth)
  # Accepts optional mentions array (user IDs) for notification creation
  createComment(componentId: ID!, content: String!, mentions: [String!]): Comment!

  # Guest: Create a comment on a component (IAM auth)
  # Verifies guest has access to the component's project
  # Accepts optional mentions array (user IDs) for notification creation
  guestCreateComment(guestId: ID!, componentId: ID!, content: String!, mentions: [String!]): Comment! @aws_iam

  # ============================================
  # Guest Notification Mutations
  # ============================================

  # Guest: Mark notification as read (IAM auth)
  guestMarkNotificationRead(guestId: ID!, notificationId: ID!): GuestNotification! @aws_iam

  # Guest: Mark all notifications as read (IAM auth)
  # Uses timestamp-based marker for O(1) operation
  guestMarkAllNotificationsRead(guestId: ID!): Int! @aws_iam

  # ============================================
  # Team Invite Code Mutations
  # ============================================

  # Generate invite code for team (owner/admin only)
  # Creates TEAM_INVITE#<code> item in DynamoDB with TTL for auto-expiration
  generateTeamInvite(input: GenerateTeamInviteInput!): TeamInviteCode!

  # Join team with invite code (Cognito auth required)
  # Creates team membership record with specified role
  joinTeamWithCode(code: String!): Membership!

  # Revoke team invite code (owner/admin only)
  revokeTeamInvite(code: String!): Boolean!

  # Guest joins team with invite code (IAM auth from Identity Pool)
  # Creates GUEST#<guestId> and TEAM#<teamId>/MEMBER#GUEST#<guestId> items
  guestJoinTeam(input: GuestJoinTeamInput!): GuestTeamSession! @aws_iam

  # ============================================
  # Guest to User Migration
  # ============================================

  # Migrate guest data (assignments, comments) to authenticated user
  # Called after guest signs in and creates an account
  migrateGuestToUser(guestId: ID!, teamId: ID!): MigrationResult!
}

type Subscription {
  # Subscribe to AI generation progress updates
  # Client subscribes with sessionId returned from startAIGeneration
  onAIProgress(sessionId: ID!): AIProgress
    @aws_subscribe(mutations: ["publishAIProgress"])

  # Subscribe to component changes for a specific project
  # Clients filter by projectId to receive updates only for projects they're viewing
  onComponentChange(projectId: ID!): ComponentChange
    @aws_subscribe(mutations: ["publishComponentChange"])
}

schema {
  query: Query
  mutation: Mutation
  subscription: Subscription
}
