  const teamId = ctx.stash.teamId;

  // Query GSI1 for team invites (gsi1pk=TEAM#teamId, gsi1sk begins_with INVITE#)
  return {
    operation: 'Query',
    index: 'gsi1',
    query: {
      expression: 'gsi1pk = :pk AND begins_with(gsi1sk, :sk)',
      expressionValues: util.dynamodb.toMapValues({
        ':pk': 'TEAM#' + teamId,
        ':sk': 'INVITE#'
      })
    }
  };
