  const items = ctx.result.items || [];
  let team = null;
  const members = [];
  for (const item of items) {
    if (item.sk === 'METADATA') {
      team = item;
    } else if (item.sk && item.sk.startsWith('MEMBER#')) {
      members.push(item);
    }
  }
  if (!team) return null;
  return { team, members };
