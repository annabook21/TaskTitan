# =============================================================================
# Async AI Generation Types (must be defined before Mutation that uses them)
# =============================================================================

enum AIJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

type AIJob {
  sessionId: ID!
  status: AIJobStatus!
  createdAt: String!
}

# AIProgress type needs both IAM (for Lambda publishAIProgress) and Cognito (for frontend subscription)
type AIProgress @aws_iam @aws_cognito_user_pools {
  sessionId: ID!
  progress: Int!
  message: String!
  status: AIJobStatus!
  result: FullPlanResult
  error: String
}

input StartAIGenerationInput {
  projectId: ID!
  generateEpics: Boolean
}

# AI generation: Lambda (Bedrock) invoked by AppSync; returns generated text.
type Mutation {
  # User registration (unauthenticated - uses AdminCreateUser, sends temp password via email)
  # AWS best practice: Lambda resolver for admin SDK operations
  registerUser(input: RegisterUserInput!): RegisterUserResult! @aws_api_key

  # Sync user profile from ID token claims after OAuth callback
  # AWS Best Practice: Access token (used by AppSync) doesn't contain email/name,
  # so frontend extracts from ID token and syncs here
  # MUST be called with fresh OAuth tokens immediately after authentication
  syncUserProfile(input: SyncUserProfileInput!): User! @aws_cognito_user_pools

  # =============================================================================
  # Async AI Generation (bypasses 30s timeout)
  # =============================================================================
  # Start async AI generation - returns sessionId immediately, client subscribes for updates
  startAIGeneration(input: StartAIGenerationInput!): AIJob!
  # Internal: Lambda publishes progress updates (triggers subscription)
  # Uses IAM auth - only callable by Lambda with appsync:GraphQL permission
  publishAIProgress(sessionId: ID!, progress: Int!, message: String!, status: AIJobStatus!, result: FullPlanResultInput, error: String): AIProgress! @aws_iam

  # Legacy: Simple AI generation (returns raw string)
  generateComponentViaAI(projectId: ID!, prompt: String!): String
  # Full AI Plan Generation (workflow-aware: Scrum generates sprints, Kanban generates flat items)
  # NOTE: This has 30s timeout - use startAIGeneration for production
  generateFullPlan(input: GenerateFullPlanInput!): FullPlanResult!
  # Apply generated plan atomically (creates components, dependencies, sprints, assigns to epics)
  applyFullPlan(input: ApplyFullPlanInput!): ApplyPlanResult!
  # Refine single component via chat
  refineComponent(input: RefineComponentInput!): RefineComponentResult!
  # Refine entire plan via chat
  refineBulkPlan(input: RefineBulkPlanInput!): RefineBulkPlanResult!
  # Smart component: natural language -> structured component preview
  createSmartComponent(input: SmartComponentInput!): SmartComponentResult!
  # AI sprint planning: suggest components for a sprint based on capacity and priorities
  planSprint(input: PlanSprintInput!): SprintPlanResult!
  # Template application: 10 predefined project templates
  applyTemplate(input: ApplyTemplateInput!): ApplyTemplateResult!
  # Component breakdown: hierarchical decomposition suggestions
  suggestBreakdown(input: SuggestBreakdownInput!): SuggestBreakdownResult!
  # Wireframe generation: HTML wireframe for UI components
  generateWireframe(input: GenerateWireframeInput!): GenerateWireframeResult!
  # Import analysis: AI-powered CSV/JSON column mapping
  analyzeImportData(input: AnalyzeImportInput!): AnalyzeImportResult!
  # Import cleanup: AI-powered data normalization
  cleanupImportData(input: CleanupImportInput!): CleanupImportResult!
  # Retrospective generation: sprint analysis with estimate adjustment
  generateRetrospective(input: GenerateRetrospectiveInput!): GenerateRetrospectiveResult!
  # Project mutations
  createProject(input: CreateProjectInput!): Project!
  updateProject(id: ID!, input: UpdateProjectInput!): Project!
  deleteProject(id: ID!): Boolean!
  # Team mutations
  createTeam(input: CreateTeamInput!): TeamWithMembers!
  updateTeam(teamId: ID!, input: UpdateTeamInput!): Team!
  addTeamMember(input: AddTeamMemberInput!): Membership!
  removeTeamMember(teamId: ID!, userId: ID!): Boolean!
  updateMemberRole(input: UpdateMemberRoleInput!): Membership!
  # Component mutations
  createComponent(input: CreateComponentInput!): Component!
  updateComponent(id: ID!, input: UpdateComponentInput!): Component!
  deleteComponent(id: ID!): Boolean!
  # Dependency mutations (TransactWriteItems with ConditionCheck to verify both components exist)
  addDependency(fromComponentId: ID!, toComponentId: ID!): Dependency!
  removeDependency(fromComponentId: ID!, toComponentId: ID!): Boolean!
  # Sprint mutations
  createSprint(input: CreateSprintInput!): Sprint!
  updateSprint(id: ID!, input: UpdateSprintInput!): Sprint!
  deleteSprint(id: ID!): Boolean!
  startSprint(id: ID!): Sprint!
  completeSprint(id: ID!): Sprint!
  # Assign/remove components from sprints (updates component.sprintId + GSI2)
  assignComponentToSprint(componentId: ID!, sprintId: ID!): Component!
  removeComponentFromSprint(componentId: ID!): Component!
  # Assign/unassign users to/from components
  assignUserToComponent(componentId: ID!, userId: ID!): Assignment!
  unassignUserFromComponent(componentId: ID!, userId: ID!): Boolean!
  # Mark notification as read
  markNotificationRead(notificationId: ID!): Notification!
  # Mark all notifications as read for current user
  markAllNotificationsRead: Int!
  # Update team workflow config (DynamoDB: UpdateItem/PutItem)
  # Best practice: Direct DynamoDB for O(1) write
  updateTeamWorkflowConfig(teamId: ID!, input: UpdateWorkflowConfigInput!): TeamWorkflowConfig!

  # ============================================
  # Share Code / Guest Access Mutations
  # ============================================

  # Owner generates a share code for their project (Cognito auth required)
  # Creates SHARE_CODE#<code> item in DynamoDB with TTL for auto-expiration
  generateShareCode(input: GenerateShareCodeInput!): ShareCode!

  # Owner revokes a share code (Cognito auth required)
  revokeShareCode(code: String!): Boolean!

  # Guest joins project with share code (IAM auth from Identity Pool)
  # Creates GUEST#<guestId> and TEAM#<teamId>/MEMBER#GUEST#<guestId> items
  guestJoinProject(input: GuestJoinInput!): GuestSession! @aws_iam

  # Guest self-assigns to a component (IAM auth)
  # Only allowed if component is in guest's project
  guestAssignSelf(guestId: ID!, componentId: ID!): Assignment! @aws_iam

  # Guest unassigns self from a component (IAM auth)
  # Only allowed if guest owns the assignment
  guestUnassignSelf(guestId: ID!, componentId: ID!): Boolean! @aws_iam

  # Guest updates component status (IAM auth)
  # Only allowed on components the guest is assigned to
  guestUpdateStatus(guestId: ID!, componentId: ID!, status: ComponentStatus!): Component! @aws_iam
}

type Subscription {
  # Subscribe to AI generation progress updates
  # Client subscribes with sessionId returned from startAIGeneration
  onAIProgress(sessionId: ID!): AIProgress
    @aws_subscribe(mutations: ["publishAIProgress"])
}

schema {
  query: Query
  mutation: Mutation
  subscription: Subscription
}
