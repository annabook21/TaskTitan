    "AppSyncGraphqlAddDependencyResolver94823985": {
      "DependsOn": [
        "AppSyncGraphqlApiDynamoDBA02B9D11",
        "AppSyncGraphqlApiSchemaC2E94F39",
      ],
      "Properties": {
        "ApiId": {
          "Fn::GetAtt": [
