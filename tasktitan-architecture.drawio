        <!-- AppSync to Users -->
        <mxCell id="conn9" value="WebSocket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BC1356;strokeWidth=1;dashed=1;fontColor=#BC1356;fontSize=9;" edge="1" parent="1" source="appsync" target="users">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lambda to SQS (DLQ) -->
        <mxCell id="conn10" value="failures" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BC1356;strokeWidth=1;dashed=1;fontColor=#BC1356;fontSize=9;" edge="1" parent="1" source="lambda" target="sqs">
