        <mxCell id="legend1" parent="legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#666;" value="1. Load SPA via CloudFront" vertex="1">
          <mxGeometry height="20" width="180" x="10" y="30" as="geometry" />
        </mxCell>
        <mxCell id="legend2" parent="legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#666;" value="2. OAuth login with Cognito" vertex="1">
          <mxGeometry height="20" width="180" x="10" y="50" as="geometry" />
        </mxCell>
        <mxCell id="legend3" parent="legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#666;" value="3. GraphQL calls with JWT" vertex="1">
          <mxGeometry height="20" width="180" x="10" y="70" as="geometry" />
        </mxCell>
        <mxCell id="legend4" parent="legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#666;" value="── Sync  ┄┄ Async/Internal" vertex="1">
          <mxGeometry height="20" width="180" x="10" y="100" as="geometry" />
        </mxCell>
        <mxCell id="legend5" parent="legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#666;" value="WebSocket for real-time updates" vertex="1">
          <mxGeometry height="20" width="180" x="10" y="120" as="geometry" />
        </mxCell>

        <!-- Cost Estimate -->
        <mxCell id="cost" parent="region" style="fillColor=#FFF8E1;strokeColor=#FFA000;dashed=0;verticalAlign=top;fontStyle=1;fontColor=#E65100;whiteSpace=wrap;html=1;rounded=1;" value="Monthly Cost Estimate" vertex="1">
          <mxGeometry height="150" width="200" x="270" y="450" as="geometry" />
        </mxCell>
        <mxCell id="cost-items" parent="cost" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#666;" value="CloudFront: ~$5-15&#xa;S3: ~$1-5&#xa;AppSync: ~$5-20&#xa;DynamoDB: ~$5-25&#xa;Lambda: ~$1-10&#xa;Cognito: Free (50K MAU)&#xa;WAF: ~$5-10&#xa;─────────────&#xa;Total: ~$25-90/month" vertex="1">
          <mxGeometry height="120" width="180" x="10" y="30" as="geometry" />
        </mxCell>

        <!-- Users / Browser -->
        <mxCell id="users" parent="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.users;" value="Users" vertex="1">
          <mxGeometry height="60" width="60" x="20" y="300" as="geometry" />
        </mxCell>
        <mxCell id="browser" parent="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;" value="Browser (SPA)" vertex="1">
          <mxGeometry height="55" width="55" x="22" y="420" as="geometry" />
        </mxCell>

        <!-- Connections -->
        
        <!-- STEP 1: User -> WAF -> CloudFront -> S3 (Load SPA) -->
        <mxCell id="conn-user-waf" edge="1" parent="1" source="users" target="waf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C7131F;strokeWidth=2;fontColor=#C7131F;fontSize=9;" value="1. HTTPS">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn-waf-cf" edge="1" parent="1" source="waf" target="cloudfront" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C7131F;strokeWidth=2;fontColor=#C7131F;fontSize=9;" value="rate limit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn-cf-s3" edge="1" parent="1" source="cloudfront" target="s3-static" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#277116;strokeWidth=2;fontColor=#277116;fontSize=9;" value="OAC">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn-cf-browser" edge="1" parent="1" source="cloudfront" target="browser" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A30B5;strokeWidth=2;fontColor=#5A30B5;fontSize=9;" value="React SPA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- STEP 2: Browser -> Cognito (OAuth Login) -->
        <mxCell id="conn-browser-cognito" edge="1" parent="1" source="browser" target="cognito" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C7131F;strokeWidth=2;fontColor=#C7131F;fontSize=9;" value="2. OAuth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- STEP 3: Browser -> AppSync (GraphQL with JWT) -->
        <mxCell id="conn-browser-appsync" edge="1" parent="1" source="browser" target="appsync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BC1356;strokeWidth=2;fontColor=#BC1356;fontSize=9;" value="3. GraphQL + JWT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- STEP 4: AppSync validates with Cognito -->
        <mxCell id="conn-appsync-cognito" edge="1" parent="1" source="appsync" target="cognito" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C7131F;strokeWidth=1;dashed=1;fontColor=#C7131F;fontSize=9;" value="validate JWT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- AppSync -> DynamoDB (direct resolvers) -->
        <mxCell id="conn-appsync-dynamo" edge="1" parent="1" source="appsync" target="dynamodb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3334B9;strokeWidth=2;fontColor=#3334B9;fontSize=9;" value="CRUD">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- AppSync -> Lambda (AI mutations) -->
        <mxCell id="conn-appsync-lambda" edge="1" parent="1" source="appsync" target="lambda" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D05C17;strokeWidth=2;fontColor=#D05C17;fontSize=9;" value="AI ops">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Lambda -> Bedrock -->
        <mxCell id="conn-lambda-bedrock" edge="1" parent="1" source="lambda" target="bedrock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#116D5B;strokeWidth=2;fontColor=#116D5B;fontSize=9;" value="Claude">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Lambda -> DynamoDB (write results) -->
        <mxCell id="conn-lambda-dynamo" edge="1" parent="1" source="lambda" target="dynamodb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3334B9;strokeWidth=1;dashed=1;fontColor=#3334B9;fontSize=9;" value="write">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Lambda -> AppSync Events (publish real-time) -->
        <mxCell id="conn-lambda-events" edge="1" parent="1" source="lambda" target="appsync-events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BC1356;strokeWidth=2;fontColor=#BC1356;fontSize=9;" value="publish">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Browser -> AppSync Events (WebSocket subscription) -->
        <mxCell id="conn-browser-events" edge="1" parent="1" source="browser" target="appsync-events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D86613;strokeWidth=2;fontColor=#D86613;fontSize=9;" value="WebSocket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Lambda -> SQS DLQ (failures) -->
        <mxCell id="conn-lambda-sqs" edge="1" parent="1" source="lambda" target="sqs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#BC1356;strokeWidth=1;dashed=1;fontColor=#BC1356;fontSize=9;" value="failures">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Lambda -> SSM (config) -->
        <mxCell id="conn-lambda-ssm" edge="1" parent="1" source="lambda" target="ssm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C7131F;strokeWidth=1;dashed=1;fontColor=#C7131F;fontSize=9;" value="config">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
