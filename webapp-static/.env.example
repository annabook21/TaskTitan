# Copy to .env.local and fill with deployed stack outputs
VITE_GRAPHQL_URL=https://xxxxxxxx.appsync-api.us-east-2.amazonaws.com/graphql
VITE_USER_POOL_ID=us-east-2_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=xxxxx.auth.us-east-2.amazoncognito.com
VITE_APP_ORIGIN=https://xxxxx.cloudfront.net
VITE_AWS_REGION=us-east-2

# AppSync API Key for unauthenticated operations (registerUser, validateShareCode)
VITE_APPSYNC_API_KEY=da2-xxxxxxxxxxxxxxxxxxxxxxxxxx

# Cognito Identity Pool ID for guest access via share codes (optional)
# Get from CDK output: GuestIdentityPoolId
VITE_IDENTITY_POOL_ID=us-east-2:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
