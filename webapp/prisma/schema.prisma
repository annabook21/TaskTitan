generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

generator zod {
  provider         = "zod-prisma-types"
  output           = "../src/lib/generated/prisma/zod"
  useMultipleFiles = "true"
  writeBarrelFiles = "false"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  projectId String
  userId    String
  metadata  Json?
  createdAt DateTime     @default(now())
  Project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  User      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId])
  @@index([type]) // Add index for filtering by activity type
  @@index([projectId, type]) // Composite index for project + type queries
}

model Assignment {
  id          String    @id @default(cuid())
  componentId String
  userId      String
  assignedAt  DateTime  @default(now())
  Component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([componentId, userId])
  @@index([userId])
}

model Component {
  id                                                    String                   @id @default(cuid())
  name                                                  String
  description                                           String?
  type                                                  ComponentType            @default(TASK)
  projectId                                             String
  parentId                                              String? // For hierarchy: Epic -> Feature -> Story -> Task
  sprintId                                              String? // null = backlog
  status                                                ComponentStatus          @default(PLANNING)
  priority                                              Int                      @default(0)
  estimatedHours                                        Float?
  actualHours                                           Float? // Actual time spent (for retrospective learning)
  dueDate                                               DateTime?
  owner                                                 String? // Imported owner name (may not match a User)
  tags                                                  String[]                 @default([])
  externalId                                            String? // For import tracking (e.g., Jira key)
  // GitHub PR Integration
  githubPrUrl                                           String? // GitHub PR URL
  githubPrStatus                                        String? // "open", "draft", "merged", "closed"
  githubPrNumber                                        Int? // PR number (e.g., 123)
  githubPrTitle                                         String? // PR title
  githubPrUpdatedAt                                     DateTime? // When PR was last updated
  // Component Context (Decision Journal)
  contextDecision                                       String?                  @db.Text // What was decided
  contextRationale                                      String?                  @db.Text // Why this approach
  contextAlternatives                                   String?                  @db.Text // Alternatives considered
  contextLinks                                          String[] // Related links (pasted, not fetched)
  contextAiSummary                                      String?                  @db.Text // AI-generated "future reader" summary
  contextUpdatedAt                                      DateTime? // When context was last updated
  contextUpdatedBy                                      String? // User who last updated context
  createdAt                                             DateTime                 @default(now())
  updatedAt                                             DateTime                 @updatedAt
  Assignment                                            Assignment[]
  Project                                               Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Parent                                                Component?               @relation("ComponentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  Children                                              Component[]              @relation("ComponentHierarchy")
  Sprint                                                Sprint?                  @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  Dependency_Dependency_dependentComponentIdToComponent Dependency[]             @relation("Dependency_dependentComponentIdToComponent")
  Dependency_Dependency_requiredComponentIdToComponent  Dependency[]             @relation("Dependency_requiredComponentIdToComponent")
  Preview                                               ComponentPreview[]
  StatusHistory                                         ComponentStatusHistory[]

  @@index([projectId])
  @@index([parentId])
  @@index([sprintId])
  @@index([status])
  @@index([type])
  @@index([externalId])
  @@index([githubPrUrl])
  @@index([projectId, status]) // Composite index for project status queries
  @@index([sprintId, status]) // Composite index for sprint status queries
  @@index([projectId, type]) // Composite index for project type queries
  @@index([dueDate]) // Index for filtering by due date
  @@index([priority, status]) // Index for priority-based queries with status
}

model Dependency {
  id                                                   String    @id @default(cuid())
  dependentComponentId                                 String
  requiredComponentId                                  String
  description                                          String?
  createdAt                                            DateTime  @default(now())
  Component_Dependency_dependentComponentIdToComponent Component @relation("Dependency_dependentComponentIdToComponent", fields: [dependentComponentId], references: [id], onDelete: Cascade)
  Component_Dependency_requiredComponentIdToComponent  Component @relation("Dependency_requiredComponentIdToComponent", fields: [requiredComponentId], references: [id], onDelete: Cascade)

  @@unique([dependentComponentId, requiredComponentId])
  @@index([requiredComponentId])
}

model Membership {
  id           String   @id @default(cuid())
  userId       String
  teamId       String
  role         Role     @default(MEMBER)
  joinedAt     DateTime @default(now())
  // Capacity planning fields (industry standard formula)
  title        String? // e.g., "Frontend Developer", "QA Engineer"
  hoursPerDay  Float?   @default(6) // Default: 6 hours (accounts for meetings)
  availability Float?   @default(100) // Percentage 0-100
  Team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
}

model Project {
  id                     String                   @id @default(cuid())
  name                   String
  description            String?
  teamId                 String
  ownerId                String
  // GitHub Integration
  githubRepoUrl          String?
  githubWebhookSecret    String?
  githubPrTargetStatus   ComponentStatus?         @default(REVIEW) // Legacy field, kept for backwards compatibility
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  Activity               Activity[]
  Component              Component[]
  GitHubTransitionConfig GitHubTransitionConfig[]
  User                   User                     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  Team                   Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([teamId])
  @@index([githubRepoUrl])
}

// Configurable GitHub event to component status transitions
model GitHubTransitionConfig {
  id           String          @id @default(cuid())
  projectId    String
  event        GitHubEvent
  targetStatus ComponentStatus
  enabled      Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  Project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, event])
  @@index([projectId])
}

model Sprint {
  id        String       @id @default(cuid())
  name      String // e.g., "Sprint 23" or "Cycle 5"
  goal      String? // Optional sprint goal
  teamId    String
  startDate DateTime
  endDate   DateTime
  status    SprintStatus @default(PLANNING)
  capacity  Int? // Optional: team capacity in hours
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  Team      Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  Component Component[]

  @@index([teamId])
  @@index([startDate, endDate])
  @@index([status])
}

model Team {
  id             String              @id @default(cuid())
  name           String
  description    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  Membership     Membership[]
  Project        Project[]
  Sprint         Sprint[]
  WorkflowConfig TeamWorkflowConfig?
}

model User {
  id               String             @id
  email            String             @unique
  name             String?
  avatarUrl        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  Activity         Activity[]
  Assignment       Assignment[]
  Membership       Membership[]
  Project          Project[]
  ComponentPreview ComponentPreview[]
  Notification     Notification[]
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  componentId String? // Link to component if relevant
  projectId   String? // Link to project if relevant
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())
  User        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  TASK_COMMENT
  TASK_DUE_SOON
  TASK_OVERDUE
  SPRINT_STARTED
  SPRINT_ENDING
}

enum ActivityType {
  PROJECT_CREATED
  COMPONENT_CREATED
  COMPONENT_UPDATED
  COMPONENT_STATUS_CHANGED
  DEPENDENCY_ADDED
  DEPENDENCY_REMOVED
  MEMBER_ASSIGNED
  MEMBER_UNASSIGNED
  COMMENT_ADDED
  SPRINT_CREATED
  SPRINT_STARTED
  SPRINT_COMPLETED
  COMPONENT_ADDED_TO_SPRINT
  COMPONENT_REMOVED_FROM_SPRINT
  // GitHub Integration Events
  GITHUB_PR_OPENED
  GITHUB_PR_MERGED
  GITHUB_PR_CLOSED
  GITHUB_PR_LINKED
}

enum ComponentStatus {
  PLANNING
  IN_PROGRESS
  BLOCKED
  REVIEW
  COMPLETED
}

enum ComponentType {
  EPIC
  FEATURE
  STORY
  TASK
  BUG
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum SprintStatus {
  PLANNING // Not yet started, still being planned
  ACTIVE // Currently running
  COMPLETED // Successfully finished
  CANCELLED // Cancelled before completion
}

enum GitHubEvent {
  PR_OPENED
  PR_READY_FOR_REVIEW
  PR_APPROVED
  PR_MERGED
  PR_CLOSED
}

// Workflow configuration for teams (Pathway B: Workflow Freedom)
model TeamWorkflowConfig {
  id                   String   @id @default(cuid())
  teamId               String   @unique
  // WIP Limits (null = unlimited)
  wipLimitPlanning     Int?
  wipLimitInProgress   Int?
  wipLimitBlocked      Int?
  wipLimitReview       Int?
  // Cycle Settings
  cycleEnabled         Boolean  @default(false)
  cycleDurationWeeks   Int? // 1, 2, 4, or 6 weeks
  cycleStartDayOfWeek  Int? // 0=Sunday, 1=Monday, etc.
  // Workflow Template & Terminology
  workflowTemplate     String?  @default("CUSTOM") // "SCRUM", "KANBAN", "SHAPE_UP", "CUSTOM"
  cycleName            String?  @default("Sprint") // "Sprint", "Cycle", "Iteration"
  backlogName          String?  @default("Backlog") // "Backlog", "Icebox", "Pitches"
  // Other Configuration
  enforceEstimates     Boolean  @default(false)
  autoArchiveCompleted Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  Team                 Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

// AI-generated wireframe previews for components
model ComponentPreview {
  id           String        @id @default(cuid())
  componentId  String
  htmlContent  String        @db.Text // Store full HTML wireframe
  prompt       String        @db.Text // What user requested
  modelUsed    String        @default("claude-sonnet-4-5")
  inputTokens  Int?
  outputTokens Int?
  status       PreviewStatus @default(PENDING)
  generatedBy  String
  createdAt    DateTime      @default(now())
  Component    Component     @relation(fields: [componentId], references: [id], onDelete: Cascade)
  User         User          @relation(fields: [generatedBy], references: [id])

  @@index([componentId])
  @@index([generatedBy])
}

enum PreviewStatus {
  PENDING
  COMPLETED
  FAILED
}

// Track component status transitions for cycle time analytics
model ComponentStatusHistory {
  id          String          @id @default(cuid())
  componentId String
  status      ComponentStatus
  enteredAt   DateTime        @default(now())
  exitedAt    DateTime?
  Component   Component       @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([componentId])
  @@index([enteredAt])
}
